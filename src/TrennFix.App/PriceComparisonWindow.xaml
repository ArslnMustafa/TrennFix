<Window x:Class="TrennFix.App.PriceComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preisvergleich" Height="720" Width="1300" MinWidth="800" MinHeight="450"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="220" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8">
            Gleiche Produkte werden über alle Rechnungen und Lieferanten hinweg erkannt – auch wenn sie unterschiedlich geschrieben sind.
            Falsch zugeordnet? Unten die betroffenen Einkäufe markieren und "Trennen" klicken. Gleiches Produkt nicht erkannt? Oben mehrere
            Zeilen markieren und "Zusammenführen" klicken.
        </TextBlock>

        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">Suche:</TextBlock>
            <TextBox x:Name="SearchBox" Width="240" TextChanged="OnFilterChanged" Padding="4,3"/>
            <CheckBox x:Name="OnlyIncreases" VerticalAlignment="Center" Margin="16,0,0,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged">Nur Preiserhöhungen</CheckBox>
            <CheckBox x:Name="OnlyCheaper" VerticalAlignment="Center" Margin="16,0,0,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged">Nur wo es günstiger ging</CheckBox>
            <CheckBox x:Name="ShowSingles" VerticalAlignment="Center" Margin="16,0,0,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged">Auch nur einmal gekaufte</CheckBox>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="OnMerge" ToolTip="Markierte Zeilen sind dasselbe Produkt">Zusammenführen</Button>
                <Button Click="OnSeparate" ToolTip="Unten markierte Einkäufe gehören nicht zu diesem Produkt">Trennen</Button>
                <Button Click="OnExport" Margin="0">Excel-Export</Button>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="GroupsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5" RowHeight="26"
                  CanUserAddRows="False" SelectionChanged="OnGroupSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produkt" Binding="{Binding Name}" Width="3*"/>
                <DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="Käufe" Binding="{Binding Purchases}" Width="55"/>
                <DataGridTextColumn Header="Lieferanten" Binding="{Binding Suppliers}" Width="80"/>
                <DataGridTextColumn Header="Letzter Preis" Binding="{Binding LastPrice, StringFormat=#\,##0.00##, ConverterCulture=de-DE}" Width="90"/>
                <DataGridTextColumn Header="bei" Binding="{Binding LastSupplier}" Width="1.3*"/>
                <DataGridTextColumn Header="am" Binding="{Binding LastDate, StringFormat=dd.MM.yyyy}" Width="85"/>
                <DataGridTextColumn Header="Vorher" Binding="{Binding PreviousPrice, StringFormat=#\,##0.00##, ConverterCulture=de-DE}" Width="80"/>
                <DataGridTextColumn Header="Änderung" Binding="{Binding ChangeText}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                                    <Setter Property="Foreground" Value="#B3261E"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDecrease}" Value="True">
                                    <Setter Property="Foreground" Value="#1B6E20"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Günstigster" Binding="{Binding CheapestPrice, StringFormat=#\,##0.00##, ConverterCulture=de-DE}" Width="90"/>
                <DataGridTextColumn Header="bei" Binding="{Binding CheapestSupplier}" Width="1.3*"/>
                <DataGridTextColumn Header="Letzter Kauf teurer um" Binding="{Binding AboveCheapestText}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PaidTooMuch}" Value="True">
                                    <Setter Property="Foreground" Value="#B3261E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="#F0F0F0"/>

        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,4,0,4">Einkäufe des markierten Produkts</TextBlock>
            <DataGrid x:Name="PurchasesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="85"/>
                    <DataGridTextColumn Header="Lieferant" Binding="{Binding Supplier}" Width="1.3*"/>
                    <DataGridTextColumn Header="Rechnung" Binding="{Binding Invoice}" Width="120"/>
                    <DataGridTextColumn Header="Bezeichnung auf der Rechnung" Binding="{Binding Description}" Width="3*"/>
                    <DataGridTextColumn Header="Menge" Binding="{Binding Quantity, StringFormat=0.###, ConverterCulture=de-DE}" Width="65"/>
                    <DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="60"/>
                    <DataGridTextColumn Header="Einzelpreis" Binding="{Binding UnitPrice, StringFormat=#\,##0.00##, ConverterCulture=de-DE}" Width="90"/>
                    <DataGridTextColumn Header="Geprüft" Binding="{Binding VerifiedText}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="Gray" Margin="0,6,0,0"/>
    </Grid>
</Window>
