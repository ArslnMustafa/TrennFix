<Window x:Class="TrennFix.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Width="640" Height="680" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSave">Speichern</Button>
            <Button IsCancel="True" Margin="0">Abbrechen</Button>
        </StackPanel>

        <TabControl>
            <!-- Mailbox -->
            <TabItem Header="Postfach">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6">Woher kommen die Rechnungen?</TextBlock>
                        <RadioButton x:Name="SrcOutlook" GroupName="src" Checked="OnSourceChanged" Margin="0,2">
                            Outlook auf diesem PC (klassisches Outlook – alle Kontotypen)</RadioButton>
                        <RadioButton x:Name="SrcGraph" GroupName="src" Checked="OnSourceChanged" Margin="0,2">
                            Microsoft 365 / Exchange Online (auch ohne Outlook, auch "neues Outlook")</RadioButton>
                        <RadioButton x:Name="SrcImap" GroupName="src" Checked="OnSourceChanged" Margin="0,2">
                            IMAP (IONOS, Strato, GMX, T-Online …)</RadioButton>

                        <GroupBox x:Name="OutlookGroup" Header="Outlook" Margin="0,10,0,0" Padding="8">
                            <StackPanel>
                                <TextBlock>Konto / Datendatei (leer = Standardkonto):</TextBlock>
                                <TextBox x:Name="OutlookStore" Margin="0,3,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="GraphGroup" Header="Microsoft 365" Margin="0,10,0,0" Padding="8">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6">
                                    Einmalig im Microsoft Entra Admin Center eine App registrieren (Typ "Mobile und Desktop",
                                    Umleitungs-URI http://localhost, delegierte Berechtigung Mail.Read). Anmeldung erfolgt danach im Browser.
                                </TextBlock>
                                <TextBlock>Anwendungs-ID (Client-ID):</TextBlock>
                                <TextBox x:Name="GraphClientId" Margin="0,3,0,6"/>
                                <TextBlock>Mandant (Tenant-ID oder Domain, leer = organizations):</TextBlock>
                                <TextBox x:Name="GraphTenant" Margin="0,3,0,6"/>
                                <TextBlock>Freigegebenes Postfach (optional, z. B. rechnungen@firma.de):</TextBlock>
                                <TextBox x:Name="GraphShared" Margin="0,3,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="ImapGroup" Header="IMAP" Margin="0,10,0,0" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" VerticalAlignment="Center">Server:</TextBlock>
                                <TextBox x:Name="ImapHost" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
                                <TextBlock Grid.Row="1" VerticalAlignment="Center">Port:</TextBlock>
                                <TextBox x:Name="ImapPort" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,2"/>
                                <CheckBox x:Name="ImapSsl" Grid.Row="2" Grid.Column="1" Margin="0,4">SSL/TLS</CheckBox>
                                <TextBlock Grid.Row="3" VerticalAlignment="Center">Benutzer:</TextBlock>
                                <TextBox x:Name="ImapUser" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
                                <TextBlock Grid.Row="4" VerticalAlignment="Center">Passwort:</TextBlock>
                                <PasswordBox x:Name="ImapPassword" Grid.Row="4" Grid.Column="1" Margin="0,2" Padding="4,3"/>
                            </Grid>
                        </GroupBox>

                        <TextBlock FontWeight="SemiBold" Margin="0,14,0,4">Ordner im Postfach</TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray">
                            Ein Ordner pro Zeile, z. B. "Posteingang" oder "Posteingang/Rechnungen". Leer = Posteingang.
                        </TextBlock>
                        <TextBox x:Name="MailFolders" AcceptsReturn="True" Height="54" VerticalScrollBarVisibility="Auto" Margin="0,3,0,0"/>
                        <CheckBox x:Name="IncludeSub" Margin="0,6,0,0">
                            Unterordner mit durchsuchen (empfohlen – auch bereits einsortierte Mails werden gefunden)</CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Archive -->
            <TabItem Header="Archiv">
                <StackPanel Margin="10">
                    <TextBlock>Archivordner (Unterordner pro Lieferant und Jahr):</TextBlock>
                    <DockPanel Margin="0,3,0,0">
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Click="OnBrowseArchive">…</Button>
                        <TextBox x:Name="ArchiveRoot"/>
                    </DockPanel>
                    <CheckBox x:Name="AutoSave" Margin="0,10,0,0">PDFs nach dem Abruf sofort speichern (sonst über "PDFs speichern")</CheckBox>
                    <CheckBox x:Name="SaveMail" Margin="0,6,0,0">Original-Mail mit ablegen (.msg / .eml)</CheckBox>
                    <CheckBox x:Name="OcrEnabled" Margin="0,6,0,0">Texterkennung (OCR) für gescannte PDFs</CheckBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center">Preiswarnung ab einer Erhöhung von</TextBlock>
                        <TextBox x:Name="PriceAlert" Width="50" Margin="6,0" HorizontalContentAlignment="Right"/>
                        <TextBlock VerticalAlignment="Center">% gegenüber dem letzten Einkauf</TextBlock>
                    </StackPanel>

                    <TextBlock Margin="0,14,0,0">Erster Abruf ab (nur beim allerersten Abruf):</TextBlock>
                    <DatePicker x:Name="InitialFrom" Width="160" HorizontalAlignment="Left" Margin="0,3,0,0"/>
                    <TextBlock x:Name="LastScanInfo" Foreground="Gray" Margin="0,10,0,0"/>
                    <Button x:Name="ResetScan" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnResetScan">
                        Nächsten Abruf wieder ab diesem Datum starten</Button>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0">
                        Bereits verarbeitete Mails werden auch dann nicht doppelt importiert.</TextBlock>
                </StackPanel>
            </TabItem>

            <!-- Own company -->
            <TabItem Header="Eigene Firma">
                <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8">
                        Diese Angaben stehen auf jeder Rechnung (als Empfänger). TrennFix braucht sie, um sie nicht mit den
                        Daten des Lieferanten zu verwechseln. Steht Ihre eigene IBAN auf der Rechnung, ist das ein starkes
                        Zeichen für Lastschrift. Jeweils ein Eintrag pro Zeile.
                    </TextBlock>
                    <TextBlock>Firmenname(n):</TextBlock>
                    <TextBox x:Name="OwnNames" AcceptsReturn="True" Height="54" Margin="0,3,0,8"/>
                    <TextBlock>Eigene IBAN(s):</TextBlock>
                    <TextBox x:Name="OwnIbans" AcceptsReturn="True" Height="54" Margin="0,3,0,8"/>
                    <TextBlock>Eigene USt-IdNr.:</TextBlock>
                    <TextBox x:Name="OwnVat" AcceptsReturn="True" Height="40" Margin="0,3,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
